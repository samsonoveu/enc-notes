# Copy this file to `.env` and adjust the values for your environment.

# Port the HTTP server listens on.
PORT=3000

# Interface to bind. Use 0.0.0.0 to accept connections from outside the machine.
HOST=127.0.0.1

# One of: development | production | test
NODE_ENV=development

# Log verbosity: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Comma-separated list of allowed CORS origins, or `*` to allow any origin.
CORS_ORIGIN=*

# Where encrypted notes are stored. The file holds only ciphertext: note bodies
# are encrypted in the browser and the server never sees the password.
NOTES_FILE=data/notes.json
